# ── Supabase（必填）────────────────────────────────────────────
# Supabase 后台 → Project Settings → API 页面复制这两个值：
VITE_SUPABASE_URL=        # 例如 https://abcdefgh.supabase.co
VITE_SUPABASE_ANON_KEY=   # anon public key（以 eyJ 开头的长字符串）

# ── 部署路径（部署到 GitHub Pages 时必填）──────────────────────
# 仓库名是什么就填 /仓库名/，例如仓库叫 hanyu-quest 就填 /hanyu-quest/
# 本地开发留空或填 /
VITE_BASE_PATH=/
